{
  "name": "agentic-security",
  "version": "0.2.2",
  "description": "Read-only JavaScript security scans, lockfile audits, and dependency upgrade plans for coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-security.git"
  },
  "bin": {
    "agentic-security": "dist/cli.js",
    "agentic-security-mcp": "dist/mcp-bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs",
    "skills",
    "SKILL.md",
    "RULES.md",
    "llms.txt",
    "server.json",
    ".mcp.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "security",
    "npm",
    "dependency-audit",
    "supply-chain-security",
    "security-scanner",
    "dependency-security",
    "lockfile-audit",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "coding-agents"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.mjs",
    "ci:local": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2"
  },
  "mcpName": "io.github.pooriaarab/agentic-security",
  "homepage": "https://github.com/pooriaarab/agentic-security#readme",
  "bugs": {
    "url": "https://github.com/pooriaarab/agentic-security/issues"
  },
  "sideEffects": [
    "dist/cli.js",
    "dist/mcp-bin.js"
  ]
}
